#!/bin/bash
set -e

cd $(dirname $0)/..

source scripts/build-common
source scripts/version

if [ "${KERNEL_ARCH}" == "arm64" ]; then
    export CROSS_COMPILE=aarch64-linux-gnu-
fi

if [ "${KERNEL_ARCH}" == "mips" ]; then
    export CROSS_COMPILE=mips64el-linux-gnuabi64-
fi

export CCACHE_DIR="${HOME}/.kernel-ccache"
export CC="ccache gcc"
export PATH="/usr/lib/ccache:$PATH"
DIR=${VERSION}
FIRMWARE=$(readlink -f firmware/${KERNEL_ARCH}/firmware)
MODULE_LIST=$(readlink -f modules/${KERNEL_ARCH}/modules.list)
MODULE_EXTRA_LIST=$(readlink -f modules/${KERNEL_ARCH}/modules-extra.list)

if [ -e "/source/dist/kernel/linux-${KERNEL_VERSION}-${KERNEL_ARCH}.tar.gz" ]; then
    echo "skipping kernel build - found linux-${KERNEL_VERSION}-burmilla-${KERNEL_ARCH}.tar.gz in ./dist/kernel/"
else
    cd ${BUILD}/${DIR}
    make ARCH=${KERNEL_ARCH} oldconfig
    if grep -q '^CONFIG_DEBUG_INFO_BTF=y' ${CONFIG}/${KERNEL_ARCH}/kernel-config \
        && ! grep -q '^CONFIG_DEBUG_INFO_BTF=y' .config; then
        echo "ERROR: oldconfig disabled CONFIG_DEBUG_INFO_BTF, install pahole in the build image"
        exit 1
    fi
    KVER=$(make ARCH=${KERNEL_ARCH} kernelrelease)
    if [ -e "linux-${KERNEL_VERSION}-${KERNEL_ARCH}.tar" ] \
        && [ "$KVER" == "$KERNEL_VERSION" ]; then
        echo "Skipping kernel build, found linux-${KERNEL_VERSION}-${KERNEL_ARCH}.tar in $(pwd)"
    else
        echo "building $KVER"
        make ARCH=${KERNEL_ARCH} -j$(nproc) INSTALL_MOD_STRIP=1 tar-pkg
    fi
fi
