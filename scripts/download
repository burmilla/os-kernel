#!/bin/bash
set -e
set -x

cd $(dirname $0)/..

source scripts/build-common

mkdir -p ${ARTIFACTS}
cd ${ARTIFACTS}

if [ ! -e "${KERNEL_TAR}" ]; then
    curl -sL ${KERNEL_URL}${KERNEL_TAR} > ${KERNEL_TAR}
fi
# kernel.org publishes a signed list of checksums next to the tarballs
curl -sL ${KERNEL_URL}sha256sums.asc | grep " ${KERNEL_TAR}$" | sha256sum -c -
