#!/bin/bash

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    DIRTY="-dirty"
fi

COMMIT=$(git rev-parse --short HEAD)
GIT_TAG=$(git tag -l --contains HEAD | head -n 1)

if [[ -z "$DIRTY" && -n "$GIT_TAG" ]]; then
    VERSION=$GIT_TAG
else
    VERSION="${COMMIT}${DIRTY}"
fi

SUFFIX=""
if [ -n "${ARCH}" ] && [ "${ARCH}" != "amd64" ]; then
    SUFFIX="_${ARCH}"
fi

case $ARCH in
    amd64)
        KERNEL_ARCH=x86
        ;;
    *)
        KERNEL_ARCH=${ARCH}
        ;;
esac
HOST_KERNEL_ARCH=${KERNEL_ARCH}

if [ -n "${OVERRIDE_KERNEL_ARCH}" ]; then
    KERNEL_ARCH=${OVERRIDE_KERNEL_ARCH}
fi

if [ "${KERNEL_ARCH}" != "${HOST_KERNEL_ARCH}" ]; then
    SUFFIX="_${KERNEL_ARCH}"
fi

# Debug info is only built for BTF, so it is stripped from vmlinux and modules.
# riscv objects also keep millions of local .L labels that --strip-debug leaves
STRIP_FLAGS="--strip-debug"
if [ "${KERNEL_ARCH}" == "riscv" ]; then
    STRIP_FLAGS="--strip-debug --discard-locals"
fi
