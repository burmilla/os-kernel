#!/bin/bash
set -e

BASE=images

source $(dirname $0)/version
cd $(dirname $0)/..

mkdir -p dist
> dist/images

# Images are built for the host architecture and tagged without an arch
# suffix, so a cross-compiled kernel would overwrite the host images
if [ "${KERNEL_ARCH}" != "${HOST_KERNEL_ARCH}" ]; then
    echo "Skipping images, ${KERNEL_ARCH} kernel is cross-compiled on ${HOST_KERNEL_ARCH}"
    exit 0
fi

for i in $BASE/[1-9]*; do
    name="os-$(echo ${i} | cut -f2 -d-)"
    tag="${OS_REPO}/${name}:${KERNEL_VERSION}${SUFFIX}"
    echo Building ${tag}
    if [ -e ${i}/prebuild.sh ]; then
        echo "running ${i}/prebuild.sh in $(pwd)"
        ${i}/prebuild.sh
    fi

    if dapper -d --build -f ${i}/Dockerfile -- -t burmilla/${name} --build-arg KERNEL_VERSION ${i}; then
        docker tag burmilla/${name} ${tag}
        echo ${tag} >> dist/images
    elif [ "$?" != "42" ]; then
        exit 1
    else
        echo "Skipping ${tag}"
    fi
done
